      "refersTo": "nav-link",
      "description": "Bold links; a three-stop trace stroke scales in on hover and stays under the current page.",
      "html": "<ul class=\"ds-nav\"><li><a href=\"#\" aria-current=\"page\">Início</a></li><li><a href=\"#\">Pesquisa</a></li><li><a href=\"#\">Projetos</a></li></ul>",
      "css": ".ds-nav{list-style:none;display:flex;gap:4px 24px;padding:0;margin:0}.ds-nav a{position:relative;display:inline-flex;align-items:center;min-height:44px;color:var(--color-text,#f2f5fb);font-weight:700;text-decoration:none}.ds-nav a::after{content:'';position:absolute;inset-inline:0;bottom:6px;height:4px;border-radius:999px;background:linear-gradient(90deg,var(--trace-slow,#ffb703),var(--trace-mid,#ff6f9f),var(--trace-fast,#7fd4ff));transform:scaleX(0);transform-origin:left;transition:transform .35s cubic-bezier(.16,1,.3,1)}.ds-nav a:hover::after,.ds-nav a[aria-current=page]::after{transform:scaleX(1)}.ds-nav a:focus-visible{outline:3px solid var(--color-focus,#7fd4ff);outline-offset:3px}"
    },

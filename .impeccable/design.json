  "components": [
    {
      "name": "Call Button",
      "kind": "button",
      "refersTo": "button-link",
      "description": "Primary call to action: amber pill that slides 4px right on hover.",
      "html": "<a class=\"ds-btn-link\" href=\"#\">Ver colaboração</a>",
      "css": ".ds-btn-link{display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:12px 24px;border-radius:999px;background:var(--trace-slow,#ffb703);color:var(--color-bg,#0b1424);font-family:var(--font-display);font-weight:700;text-decoration:none;transition:transform .25s cubic-bezier(.16,1,.3,1)}.ds-btn-link:hover{transform:translateX(4px)}.ds-btn-link:focus-visible{outline:3px solid var(--color-focus,#7fd4ff);outline-offset:3px}"
    },
    {
      "name": "Theme Toggle",
      "kind": "button",
      "refersTo": "button-toggle",
      "description": "Outlined 4px-radius button; border turns amber on hover and when pressed.",
      "html": "<button class=\"ds-toggle\" aria-pressed=\"false\">Tema escuro</button>",
      "css": ".ds-toggle{min-height:44px;min-width:44px;font:inherit;color:inherit;background:transparent;border:2px solid var(--color-border,#7388ab);border-radius:4px;padding:8px 12px;cursor:pointer;transition:border-color .2s cubic-bezier(.16,1,.3,1)}.ds-toggle:hover,.ds-toggle[aria-pressed=true]{border-color:var(--trace-slow,#ffb703)}.ds-toggle:focus-visible{outline:3px solid var(--color-focus,#7fd4ff);outline-offset:3px}"
    },
    {
      "name": "Nav",

---
import Base from "../layouts/Base.astro";
import Card from "../components/Card.astro";
import Abbr from "../components/Abbr.astro";
import Trace from "../components/Trace.astro";
import fs from "node:fs";
import path from "node:path";
import { getCollection } from "astro:content";
import { t } from "../i18n";

const temFoto = fs.existsSync(path.join(process.cwd(), "public", "foto-jaline.jpg"));
const destaques = (await getCollection("casos"))
  .filter((c) => c.data.destaque)
  .sort((a, b) => a.data.ordem - b.data.ordem);

// Textos com siglas usam {SIGLA} como marcador; cada sigla vira <abbr> com a expansão de sigla.*.
type Segmento = { sigla: string; significado: string } | { texto: string };
const segmentos = (texto: string): Segmento[] =>
  texto.split(/(\{[\w.-]+\})/).map((parte): Segmento => {
    const m = parte.match(/^\{([\w.-]+)\}$/);
    return m ? { sigla: m[1], significado: t(`sigla.${m[1]}`) } : { texto: parte };
  });
---
<Base title={t("nav.inicio")} description={t("site.posicionamento")} wide>
  <section class="hero">
    <div class="hero-text">
      <h1>{t("site.nome")}</h1>
      <p class="lede">{t("site.posicionamento")}</p>
    </div>
    {temFoto && (
      <img class="hero-foto" src="/foto-jaline.jpg" alt="Retrato de Jaline Gonçalves Mombach" width="480" height="600" />
    )}
    <Trace />
  </section>

  <section aria-labelledby="atuacao-titulo">
    <h2 id="atuacao-titulo" class="section-title">{t("inicio.atuacaoTitulo")}</h2>
    <!-- REVISAR: bloco 3 não cita ano de início do IFFar; o currículo indica substituta em 2013 e o resumo indica desde 2014. Confirmar ao incluir a data. -->
    <div>
      <section>
        <h3>{t("inicio.bloco1Titulo")}</h3>
        <p>{segmentos(t("inicio.bloco1Texto")).map((s) => ("sigla" in s ? <Abbr sigla={s.sigla} significado={s.significado} /> : s.texto))}</p>
      </section>
      <section>
        <h3>{t("inicio.bloco2Titulo")}</h3>
        <p>{segmentos(t("inicio.bloco2Texto")).map((s) => ("sigla" in s ? <Abbr sigla={s.sigla} significado={s.significado} /> : s.texto))}</p>
      </section>
      <section>
        <h3>{t("inicio.bloco3Titulo")}</h3>
        <p>{segmentos(t("inicio.bloco3Texto")).map((s) => ("sigla" in s ? <Abbr sigla={s.sigla} significado={s.significado} /> : s.texto))}</p>
      </section>
    </div>
  </section>

  <section aria-labelledby="destaques-titulo">
    <h2 id="destaques-titulo" class="section-title">{t("inicio.destaquesTitulo")}</h2>
    <div>
      {destaques.map((c) => (
        <Card titulo={c.data.titulo} href={`/projetos/${c.data.slug}`} descricao={c.data.resumo} />
      ))}
    </div>
  </section>

  <section class="cta">
    <p>{t("inicio.ctaTexto")}</p>
    <p><a class="button-link" href="/colaboracao">{t("inicio.cta")}</a></p>
  </section>
</Base>
<style>
  .hero {
    position: relative;
    display: grid;
    gap: var(--space-5);
    padding-block-start: var(--space-6);
    touch-action: pan-y;
  }
  .hero :global(h1) {
    font-size: var(--font-size-hero);
    line-height: 1;
    letter-spacing: -0.035em;
    max-width: 14ch;
  }
  .lede {
    margin-block-start: var(--space-4);
    max-width: 42ch;
    font-size: var(--font-size-lg);
    color: var(--color-text-muted);
  }
  .hero-foto {
    width: min(100%, 22rem);
    border-radius: var(--radius);
    justify-self: start;
  }
  @media (min-width: 56rem) {
    .hero {
      grid-template-columns: 1fr auto;
      align-items: end;
    }
    .hero :global(.trace) {
      grid-column: 1 / -1;
    }
  }
  section > div {
    display: grid;
    gap: var(--space-5) var(--space-6);
  }
  @media (min-width: 56rem) {
    section[aria-labelledby="atuacao-titulo"] > div {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  section[aria-labelledby="destaques-titulo"] > div {
    grid-template-columns: 1fr;
  }
  @media (min-width: 40rem) {
    section[aria-labelledby="destaques-titulo"] > div {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .cta {
    margin-block-start: var(--space-8);
  }
  .cta p:first-child {
    max-width: 30ch;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--font-size-xl);
    line-height: 1.15;
  }
  .cta p + p {
    margin-block-start: var(--space-5);
  }
  .lede {
    text-wrap: balance;
  }
  @media (min-width: 56rem) {
    section[aria-labelledby="atuacao-titulo"] h3 {
      min-block-size: calc(2 * 1.12em);
    }
  }
  section > div > section p {
    margin-block-start: var(--space-2);
    max-width: 38ch;
  }
</style>

---
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Card from "../../components/Card.astro";
import Badge from "../../components/Badge.astro";
import CopyButton from "../../components/CopyButton.astro";
import FilterBar from "../../components/FilterBar.astro";
import { getCollection } from "astro:content";
import { t } from "../../i18n";
import { getLattes } from "../../lib/data";
import { doiUrl, formatCitation, idiomaTitulo, idiomaVeiculo } from "../../lib/citation";
import { ordenarPublicacoes, searchText } from "../../lib/filters";

// Registros no INPI (Base Programas). A consulta do INPI é por sessão: o link leva à busca, o número identifica o pedido.
const INPI_BUSCA = "https://busca.inpi.gov.br/pePI/jsp/programas/ProgramaSearchBasico.jsp";
const registrosInpi: Record<string, { pedido: string; deposito: string }> = {
  "Calculadora de Matrículas Totais do IFFar": { pedido: "BR 51 2026 004572 0", deposito: "16/06/2026" },
  "Calculadora de Matrículas Equivalentes": { pedido: "BR 51 2026 004563 0", deposito: "16/06/2026" },
  "Acompanhamento de Matrículas e Indicadores de Ensino do IFFar": { pedido: "BR 51 2026 004560 6", deposito: "16/06/2026" },
  "Painel de Acompanhamento dos Processos Seletivos do IFFar": { pedido: "BR 51 2026 004557 6", deposito: "16/06/2026" },
  "Panorama dos Cursos de Pós-Graduação do IFFar": { pedido: "BR 51 2026 004553 3", deposito: "16/06/2026" },
};

const lattes = getLattes();
const conferencias = lattes.apresentacoes.filter((a) => a.natureza === "CONFERENCIA");
const outrasApresentacoes = lattes.apresentacoes.filter((a) => a.natureza !== "CONFERENCIA");
const orientacoesAtuais = lattes.orientacoes.filter((o) => o.status === "em-andamento");
const orientacoesConcluidas = lattes.orientacoes.filter((o) => o.status === "concluida");
const publicacoes = ordenarPublicacoes(lattes.publicacoes);
function nivelOrientacao(natureza: string): string {
  const tipo = natureza.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase();
  if (tipo.includes("especializacao")) return "Pós-graduação (lato sensu)";
  if (tipo.includes("graduacao")) return "Graduação";
  return natureza;
}

// Opções dos filtros, derivadas dos dados (rótulos vêm de pt.json; t() falha se faltar uma chave).
const tipos = [...new Set(publicacoes.map((p) => p.tipo))].map((valor) => ({
  valor,
  rotulo: t(`pub.tipo.${valor}`),
}));
const temas = [...new Set(publicacoes.map((p) => p.tema))]
  .map((valor) => ({ valor, rotulo: t(`pub.tema.${valor}`) }))
  .sort((a, b) => a.rotulo.localeCompare(b.rotulo, "pt-BR"));
const anos = [...new Set(publicacoes.map((p) => String(p.ano)))];

// Projetos sem ano de fim no Lattes são tratados como em andamento.
const projetosAtuais = lattes.projetos.filter((p) => p.fim === null);

const estudos = (await getCollection("pesquisa")).sort((a, b) => a.data.ordem - b.data.ordem);
---
<Base title={t("pesquisa.titulo")} description={t("pesquisa.intro")}>
  <Breadcrumbs items={[{ label: t("nav.inicio"), href: "/" }, { label: t("pesquisa.titulo") }]} />
  <h1>{t("pesquisa.titulo")}</h1>

  <nav class="atalhos-pesquisa" aria-label={t("pesquisa.navegacaoLocal")}>
    <section aria-labelledby="nav-pesquisa">
      <h2 id="nav-pesquisa">{t("pesquisa.navPesquisa")}</h2>
      <ul>
        <li><a href="#eixos">{t("sobre.eixosTitulo")}</a></li>
        <li><a href="#projetos-nacionais">{t("pesquisa.navNacionais")}</a></li>
        <li><a href="#estudos">{t("pesquisa.estudosTitulo")}</a></li>
        <li><a href="#projetos-pesquisa">{t("pesquisa.navAndamento")}</a></li>
      </ul>
    </section>
    <section aria-labelledby="nav-producao">
      <h2 id="nav-producao">{t("pesquisa.navProducao")}</h2>
      <ul>
        <li><a href="#producao-tecnica">{t("pesquisa.tecnicaTitulo")}</a></li>
        <li><a href="#palestras">{t("pesquisa.palestrasTitulo")}</a></li>
        <li><a href="#orientacoes">{t("pesquisa.orientacoesTitulo")}</a></li>
        <li><a href="#publicacoes">{t("pesquisa.publicacoesTitulo")}</a></li>
      </ul>
    </section>
  </nav>
  <h2 class="section-title" id="eixos">{t("sobre.eixosTitulo")}</h2>
  {[1, 2, 3, 4].map((numero) => (
    <section class="eixo-pesquisa">
      <h3>{t(`sobre.eixo${numero}Titulo`)}</h3>
      <p>{t(`sobre.eixo${numero}Texto`)}</p>
    </section>
  ))}

  <h2 class="section-title" id="projetos-nacionais">{t("pesquisa.nacionaisTitulo")}</h2>
  <p>{t("pesquisa.nacionaisIntro")}</p>
  {[
    { chave: "cecate", slug: "cecate-nordeste", repo: "CecateNE" },
    { chave: "pnp", slug: "plataforma-nilo-pecanha", repo: "PNP" },
  ].map((projeto) => (
    <section class="projeto-nacional">
      <img class="projeto-nacional-imagem" src={`/projetos/${projeto.slug}.png`} alt={projeto.chave === "cecate" ? "Cecate Nordeste — Polo Arapiraca, Alagoas" : "Plataforma Nilo Peçanha — Plano de Trabalho 2024–2028"} loading="lazy" />
      <div class="projeto-nacional-conteudo">
      <h3>{t(`pesquisa.${projeto.chave}Titulo`)}</h3>
      <p class="financiamento"><strong>{t(`pesquisa.${projeto.chave}Financiamento`)}</strong></p>
      <p>{t(`pesquisa.${projeto.chave}Descricao`)}</p>
      <ul class="links-projeto">
        <li><a href={`/projetos/${projeto.slug}`}>{t("pesquisa.verAtuacao")}</a></li>
        <li><a href={`https://github.com/Rede-DSBR/${projeto.repo}`}>{t("pesquisa.verRepositorio")}</a></li>
      </ul>
      </div>
    </section>
  ))}

  <h2 class="section-title" id="producao-tecnica">{t("pesquisa.tecnicaTitulo")}</h2>
  <p>{t("pesquisa.tecnicaIntro")}</p>
  <h3>{t("pesquisa.softwareTitulo")}</h3>
  <ul class="registros">
    {lattes.software.map((s) => (
      <li>
        {s.titulo} ({s.ano})
        {registrosInpi[s.titulo] && (
          <>
            {" "}
            <a href={INPI_BUSCA} rel="noopener" target="_blank">
              Registro no INPI: {registrosInpi[s.titulo].pedido}<span class="visually-hidden"> (abre em nova aba)</span>
            </a>
            , depositado em {registrosInpi[s.titulo].deposito}.
          </>
        )}
      </li>
    ))}
  </ul>
  <p><a href="/projetos/paineis-pnp-indicadores">{t("pesquisa.verPaineis")}</a></p>
  <h3>{t("sobre.patente")}</h3>
  <p>{lattes.patente.titulo} ({lattes.patente.ano}).</p>
  <p><a href="/projetos/automacao-academico-regulatoria">{t("pesquisa.verAutomacao")}</a></p>

  <h2 class="section-title" id="palestras">{t("pesquisa.palestrasTitulo")}</h2>
  <p>{t("pesquisa.palestrasIntro")}</p>
  <ul class="registros">
    {conferencias.map((item) => (
      <li><strong>{item.titulo}</strong><p>{item.evento} <span class="ajuda">({item.ano})</span></p></li>
    ))}
  </ul>
  <details class="historico">
    <summary>{t("pesquisa.outrasApresentacoes")}</summary>
    <ul class="registros">
      {outrasApresentacoes.map((item) => (
        <li><strong>{item.titulo}</strong><p>{item.evento} <span class="ajuda">({item.ano})</span></p></li>
      ))}
    </ul>
  </details>

  <h2 class="section-title" id="orientacoes">{t("pesquisa.orientacoesTitulo")}</h2>
  <p>{t("pesquisa.orientacoesIntro")}</p>
  <p class="ajuda">{t("pesquisa.fonteOrientacoes")}</p>
  <h3>{t("status.emAndamento")}</h3>
  <ul class="registros">
    {orientacoesAtuais.map((item) => (
      <li><strong>{item.titulo}</strong><p>{nivelOrientacao(item.natureza)} · {item.instituicao} <span class="ajuda">({item.ano})</span></p></li>
    ))}
  </ul>
  <h3>{t("pesquisa.concluidasTitulo")}</h3>
  <ul class="registros">
    {orientacoesConcluidas.map((item) => (
      <li><strong>{item.titulo}</strong><p>{nivelOrientacao(item.natureza)} · {item.instituicao} <span class="ajuda">({item.ano})</span></p></li>
    ))}
  </ul>

  <h2 class="section-title" id="estudos">{t("pesquisa.estudosTitulo")}</h2>
  <div class="cards">
    {estudos.map((estudo) => (
      <Card
        titulo={estudo.data.titulo}
        href={`/pesquisa/${estudo.data.slug}`}
        descricao={estudo.data.resumo}
      />
    ))}
  </div>

  <h2 class="section-title" id="projetos-pesquisa">{t("pesquisa.projetosTitulo")}</h2>
  <ul class="lista-simples">
    {projetosAtuais.map((projeto) => (
      <li>
        {projeto.titulo} <Badge variante="info" texto={t("status.emAndamento")} />{" "}
        <span class="ajuda">{t("pesquisa.desde", { ano: projeto.inicio ?? "" })}</span>
      </li>
    ))}
  </ul>

  <h2 class="section-title" id="publicacoes">{t("pesquisa.publicacoesTitulo")}</h2>
  <p>{t("pesquisa.publicacoesIntro")}</p>

  <FilterBar listaId="publicacoes-lista" tipos={tipos} anos={anos} temas={temas} total={publicacoes.length} />

  <ul id="publicacoes-lista" class="publicacoes">
    {publicacoes.map((p) => {
      const idioma = idiomaTitulo(p.titulo);
      const url = doiUrl(p.doi);
      return (
        <li data-tipo={p.tipo} data-ano={String(p.ano)} data-tema={p.tema} data-texto={searchText(p)} data-filtro-item>
          <p class="pub-titulo">
            {idioma === "en" ? <span lang="en">{p.titulo}</span> : p.titulo}
          </p>
          {p.autores.length > 0 && <p class="pub-autores">{p.autores.join("; ")}</p>}
          <p class="pub-veiculo">{idiomaVeiculo(p.veiculo) === "en" ? <span lang="en">{p.veiculo}</span> : p.veiculo}, {p.ano}</p>
          <ul class="card-badges">
            <li><Badge variante="neutro" texto={t(`pub.tipo.${p.tipo}`)} /></li>
            <li><Badge variante="neutro" texto={t(`pub.tema.${p.tema}`)} /></li>
          </ul>
          {url && (
            <p>
              <a href={url}>{t("pub.doi")}: {p.doi}<span class="visually-hidden"> {t("link.externo")}</span></a>
            </p>
          )}
          <CopyButton texto={formatCitation(p)} rotulo={t("copiar.citacao")} rotuloOk={t("copiar.citacaoOk")} />
        </li>
      );
    })}
  </ul>
</Base>

<style>
  .projeto-nacional {
    display: grid;
    grid-template-columns: 12rem minmax(0, 1fr);
    gap: var(--space-5);
    align-items: start;
    margin-block-start: var(--space-6);
  }
  .projeto-nacional-imagem {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
  }
  .projeto-nacional-conteudo { min-inline-size: 0; }
  .projeto-nacional h3 { margin-block-start: 0; }
  @media (max-width: 40rem) {
    .projeto-nacional { grid-template-columns: minmax(0, 1fr); }
    .projeto-nacional-imagem { max-width: 20rem; }
  }
  .projeto-nacional p { margin-block-start: var(--space-3); }
  .financiamento { color: var(--color-accent); }
  .links-projeto { padding-inline-start: var(--space-5); }

  .registros { padding-inline-start: var(--space-5); }
  .registros > li + li { margin-block-start: var(--space-4); }
  .registros p { margin: var(--space-1) 0 0; }
  .historico { margin-block-start: var(--space-5); }
  .historico summary { cursor: pointer; padding-block: var(--space-2); }

  .atalhos-pesquisa {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: var(--space-5) var(--space-7);
    padding: var(--space-5);
    background: var(--color-surface);
    border-radius: var(--radius);
  }
  .atalhos-pesquisa section { min-inline-size: 0; }
  .atalhos-pesquisa h2 { margin: 0 0 var(--space-3); font-size: var(--font-size-lg); }
  .atalhos-pesquisa ul { list-style: none; margin: 0; padding: 0; }
  .atalhos-pesquisa li + li { border-block-start: 1px solid var(--color-rule); }
  .atalhos-pesquisa a {
    display: flex;
    align-items: center;
    min-block-size: 44px;
    padding-block: var(--space-2);
    overflow-wrap: anywhere;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }
  .atalhos-pesquisa a:hover { color: var(--color-text); }


  .eixo-pesquisa + .eixo-pesquisa { margin-block-start: var(--space-5); }
  .lista-simples {
    padding-inline-start: var(--space-4);
  }
  .ajuda {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }
  .cards {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
  }
  .publicacoes {
    list-style: none;
    padding: 0;
    display: grid;
    gap: var(--space-3);
  }
  .publicacoes > li {
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    display: grid;
    gap: var(--space-2);
    justify-items: start;
  }
  .publicacoes > li[hidden] {
    display: none;
  }
  .pub-titulo {
    font-weight: 600;
  }
  .pub-autores,
  .pub-veiculo {
    font-size: var(--font-size-sm);
  }
  .card-badges {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
</style>

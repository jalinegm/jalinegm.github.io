---
import Base from "../layouts/Base.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import CopyButton from "../components/CopyButton.astro";
import { t } from "../i18n";
import { EMAIL, PERFIS } from "../lib/contato";
---
<Base title={t("colaboracao.titulo")} description={t("colaboracao.texto")}>
  <Breadcrumbs items={[{ label: t("nav.inicio"), href: "/" }, { label: t("colaboracao.titulo") }]} />
  <h1>{t("colaboracao.titulo")}</h1>
  <p>{t("colaboracao.texto")}</p>

  <h2 class="section-title">{t("colaboracao.emailTitulo")}</h2>
  <p><a href={`mailto:${EMAIL}`}>{EMAIL}</a></p>
  <CopyButton texto={EMAIL} rotulo={t("copiar.email")} rotuloOk={t("copiar.emailOk")} />

  <h2 class="section-title">{t("colaboracao.perfisTitulo")}</h2>
  <ul class="perfis">
    <li><a class="button-link" href={PERFIS.lattes}>{t("perfil.lattes")}</a></li>
    <li><a class="button-link" href={PERFIS.linkedin}>{t("perfil.linkedin")}</a></li>
  </ul>
</Base>
<style>
  .perfis {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
</style>

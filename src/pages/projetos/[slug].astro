---
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import Card from "../../components/Card.astro";
import { getCollection, render } from "astro:content";
import { t } from "../../i18n";
import { reposByNames } from "../../lib/data";
import { cardPropsRepo } from "../../lib/repos-view";

export async function getStaticPaths() {
  const entries = await getCollection("casos");
  return entries.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { titulo, vinculo, periodo, resumo, tecnologias, repos, tese } = entry.data;
const relacionados = reposByNames(repos);
---
<Base title={titulo} description={resumo}>
  <Breadcrumbs
    items={[
      { label: t("nav.inicio"), href: "/" },
      { label: t("projetos.titulo"), href: "/projetos" },
      { label: titulo },
    ]}
  />
  <h1>{titulo}</h1>
  <p>{resumo}</p>

  <dl class="meta">
    <dt>{t("projetos.vinculo")}</dt>
    <dd>{vinculo}</dd>
    {periodo && (
      <>
        <dt>{t("projetos.periodoRotulo")}</dt>
        <dd>{periodo}</dd>
      </>
    )}
    <dt>{t("projetos.tecnologias")}</dt>
    <dd>
      <ul class="tecnologias">
        {tecnologias.map((item) => <li>{item}</li>)}
      </ul>
    </dd>
  </dl>

  {tese && (
    <p>
      <a class="button-link" href={`/pesquisa/${tese}`}>{t("projetos.tese")}</a>
    </p>
  )}

  <Content />

  <section aria-labelledby="repos-caso">
    <h2 id="repos-caso" class="section-title">{t("projetos.reposCaso")}</h2>
    {relacionados.length === 0 ? (
      <p>{t("projetos.semRepos")}</p>
    ) : (
      <ul class="cards">
        {relacionados.map((r) => (
          <li><Card {...cardPropsRepo(r)} /></li>
        ))}
      </ul>
    )}
  </section>
</Base>

<style>
  .meta {
    display: grid;
    gap: var(--space-2) var(--space-4);
    grid-template-columns: max-content 1fr;
    margin-block: var(--space-4);
  }
  .meta dt {
    font-weight: 600;
  }
  .meta dd {
    margin: 0;
  }
  .tecnologias {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
  }
  .cards {
    display: grid;
    gap: var(--space-4);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    list-style: none;
    padding: 0;
  }
</style>

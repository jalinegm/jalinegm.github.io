---
import { t } from "../i18n";

interface Item {
  periodo: string;
  titulo: string;
  instituicao: string;
  detalhe?: string;
  detalheHref?: string;
  orientacao?: string;
  status?: "em-andamento" | "concluido";
}

interface Props {
  itens: Item[];
}

const { itens } = Astro.props;
---
<ol class="timeline">
  {itens.map((item) => (
    <li class:list={["etapa", item.status === "em-andamento" && "etapa--agora"]}>
      <p class="etapa-periodo">
        <span class="etapa-ano">{item.periodo}</span>
        {item.status === "em-andamento" && <span class="etapa-agora">{t("status.emAndamento")}</span>}
      </p>
      <div class="etapa-corpo">
        <h3>{item.titulo.split(/(lato sensu)/).map((parte) => parte === "lato sensu" ? <i lang="la">{parte}</i> : parte)}</h3>
        <p class="etapa-inst">{item.instituicao}</p>
        {item.detalhe && (
          <p class="etapa-detalhe">
            {item.detalheHref ? <a href={item.detalheHref}>{item.detalhe}</a> : item.detalhe}.
            {item.orientacao && <> {item.orientacao}</>}
          </p>
        )}
      </div>
    </li>
  ))}
</ol>
<style>
  .timeline {
    --rail-x: 8rem;
    list-style: none;
    margin: var(--space-4) 0 0;
    padding: 0;
    position: relative;
  }
  /* trilho contínuo */
  .timeline::before {
    content: "";
    position: absolute;
    inset-block: 0.6rem 0;
    inset-inline-start: calc(var(--rail-x) + 0.5px);
    width: 2px;
    margin-inline-start: -1px;
    background: linear-gradient(to bottom, var(--color-accent), var(--color-rule) 18%);
  }
  .etapa {
    display: grid;
    grid-template-columns: var(--rail-x) 1fr;
    column-gap: var(--space-5);
    position: relative;
    padding-block-end: var(--space-5);
  }
  .etapa:last-child {
    padding-block-end: var(--space-4);
  }
  /* ponto no trilho */
  .etapa::before {
    content: "";
    position: absolute;
    inset-inline-start: var(--rail-x);
    inset-block-start: 0.45rem;
    width: 0.9rem;
    height: 0.9rem;
    margin-inline-start: -0.45rem;
    border-radius: 50%;
    background: var(--color-bg);
    border: 2px solid var(--color-accent);
    z-index: 1;
  }
  .etapa--agora::before {
    background: var(--color-accent);
  }
  .etapa-periodo {
    margin: 0;
    padding-inline-end: var(--space-5);
    text-align: end;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--space-1);
  }
  .etapa-ano {
    font-size: var(--font-size-sm);
    font-weight: 400;
    font-variant-numeric: tabular-nums;
    color: var(--color-text-muted);
    line-height: 1.5;
  }
  .etapa-agora {
    font-size: 0.75rem;
    font-weight: 400;
    padding: 0.15rem var(--space-2);
    line-height: 1.4;
    max-inline-size: 100%;
    overflow-wrap: anywhere;
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-link);
  }
  .etapa-corpo h3 {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.45;
    text-wrap: balance;
  }
  .etapa-corpo { min-inline-size: 0; overflow-wrap: anywhere; }
  .etapa-inst {
    margin: var(--space-1) 0 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-sm);
    font-weight: 400;
  }
  .etapa-detalhe {
    margin: var(--space-2) 0 0;
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    max-width: var(--measure);
  }

  @keyframes pulso {
    0%, 100% { box-shadow: 0 0 0 0.2rem color-mix(in srgb, var(--color-accent) 30%, transparent); }
    50% { box-shadow: 0 0 0 0.6rem color-mix(in srgb, var(--color-accent) 0%, transparent); }
  }
  @keyframes entra {
    from { opacity: 0; translate: 0 1.5rem; filter: blur(4px); }
    to { opacity: 1; translate: 0 0; filter: blur(0); }
  }
  @keyframes ponto {
    from { scale: 0.3; }
    to { scale: 1; }
  }
  @keyframes trilho {
    from { transform: scaleY(0.2); }
    to { transform: scaleY(1); }
  }

  @supports (animation-timeline: view()) {
    .etapa-periodo,
    .etapa-corpo {
      animation: entra both var(--ease-out);
      animation-timeline: view();
      animation-range: entry 0% entry 55%;
    }
    .etapa-corpo { animation-range: entry 8% entry 65%; }
    .etapa:not(.etapa--agora)::before {
      animation: ponto both var(--ease-out);
      animation-timeline: view();
      animation-range: entry 0% entry 40%;
    }
    .timeline::before {
      transform-origin: top;
      animation: trilho both linear;
      animation-timeline: scroll(root);
      animation-range: 0 40%;
    }
  }

  @media (max-width: 40rem) {
    .timeline { --rail-x: 0.5rem; }
    .etapa {
      grid-template-columns: minmax(0, 1fr);
      padding-inline-start: var(--space-6);
      row-gap: var(--space-2);
    }
    .etapa-periodo {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      justify-content: flex-start;
      text-align: start;
      padding: 0;
    }
  }
</style>

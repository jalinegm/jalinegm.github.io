---
import { t } from "../i18n";

interface Props {
  titulo: string;
  href: string;
  resumo: string;
  periodo?: string;
  /** Caminho da imagem (painel, captura de tela). Sem ela, a linha vira só texto. */
  imagem?: string;
  alt?: string;
  /** Linha de abertura: mídia larga acima do texto. */
  lider?: boolean;
}

const { titulo, href, resumo, periodo, imagem, alt, lider } = Astro.props;
---
<article class:list={["linha", { "linha--lider": lider && imagem, "linha--texto": !imagem }]}>
  {imagem && (
    <a class="linha-midia" href={href} tabindex="-1" aria-hidden="true">
      <img src={imagem} alt="" loading="lazy" width="640" height="400" />
    </a>
  )}
  <div class="linha-texto">
    <h3><a href={href}>{titulo}</a></h3>
    {periodo && <p class="linha-periodo">{t("projetos.periodo", { periodo })}</p>}
    <p>{resumo}</p>
    <p><a class="linha-link" href={href}>{t("projetos.verProjeto")}<span class="visually-hidden">: {titulo}</span></a></p>
  </div>
</article>
<style>
  .linha {
    display: grid;
    gap: var(--space-4) var(--space-6);
    align-items: center;
    padding-block: var(--space-5);
    border-block-start: 2px solid var(--color-accent);
  }
  .linha-midia {
    display: block;
    min-block-size: 0;
    aspect-ratio: 8 / 5;
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .linha-midia img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
  }
  .linha-texto > * + * {
    margin-block-start: var(--space-3);
  }
  .linha-texto h3 {
    margin: 0;
    font-size: var(--font-size-lg);
  }
  .linha-texto h3 a {
    color: var(--color-text);
    text-decoration: none;
  }
  .linha-texto h3 a:hover {
    text-decoration: underline;
  }
  .linha-link {
    font-weight: 700;
    color: var(--color-accent);
  }
  .linha-periodo {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }
  .linha--texto .linha-texto {
    max-inline-size: var(--measure);
  }
  @media (min-width: 48rem) {
    .linha {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    }
    .linha--texto,
    .linha--lider {
      grid-template-columns: minmax(0, 1fr);
    }
    .linha--lider .linha-midia {
      aspect-ratio: 16 / 7;
    }
  }
</style>

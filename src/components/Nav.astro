---
import { t } from "../i18n";

const items = [
  { href: "/", key: "nav.inicio" },
  { href: "/sobre", key: "nav.sobre" },
  { href: "/pesquisa", key: "nav.pesquisa" },
  { href: "/projetos", key: "nav.projetos" },
];

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isCurrent = (href: string) => (href === "/" ? path === "/" : path === href || path.startsWith(href + "/"));
---
<nav aria-label={t("a11y.menu")}>
  <ul class="nav-list">
    {items.map((item) => (
      <li>
        <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>{t(item.key)}</a>
      </li>
    ))}
  </ul>
</nav>
<style>
  .nav-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-5);
    padding: 0;
    margin: 0;
  }
  .nav-list a {
    display: inline-flex;
    align-items: center;
    padding-block: var(--space-2);
    color: var(--color-text-muted);
    text-decoration: none;
    border-block-end: 2px solid transparent;
  }
  .nav-list a:hover {
    color: var(--color-text);
  }
  .nav-list a[aria-current="page"] {
    color: var(--color-text);
    font-weight: 700;
    border-block-end-color: var(--color-accent);
  }
  @media (max-width: 40rem) {
    .nav-list {
      gap: var(--space-1) var(--space-4);
    }
    .nav-list a {
      font-size: var(--font-size-sm);
    }
  }
</style>

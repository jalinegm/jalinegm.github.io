---
import { t } from "../i18n";

const items = [
  { href: "/", key: "nav.inicio" },
  { href: "/sobre", key: "nav.sobre" },
  { href: "/pesquisa", key: "nav.pesquisa" },
  { href: "/projetos", key: "nav.projetos" },
  { href: "/colaboracao", key: "nav.colaboracao" },
];

const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isCurrent = (href: string) => (href === "/" ? path === "/" : path === href || path.startsWith(href + "/"));
---
<nav aria-label={t("a11y.menu")}>
  <ul class="nav-list">
    {items.map((item) => (
      <li>
        <a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>{t(item.key)}</a>
      </li>
    ))}
  </ul>
</nav>
<style>
  .nav-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    padding: 0;
    margin: 0;
  }
  .nav-list a {
    display: inline-flex;
    align-items: center;
    padding-block: var(--space-2);
    text-decoration: none;
  }
  .nav-list a[aria-current="page"] {
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }
</style>

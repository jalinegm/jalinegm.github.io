---
import { t } from "../i18n";

const buildDate = new Date().toISOString().slice(0, 10);
const links = [
  { href: "http://lattes.cnpq.br/5793944765294091", key: "perfil.lattes" },
  { href: "https://www.linkedin.com/in/jalinegm/", key: "perfil.linkedin" },
  { href: "https://github.com/jalinegm", key: "perfil.github" },
];
---
<footer class="site-footer">
  <p>{t("rodape.instituicao")}</p>
  <ul class="footer-links">
    {links.map((l) => (
      <li><a href={l.href}>{t(l.key)}</a></li>
    ))}
    <li><a href="/colaboracao">{t("nav.colaboracao")}</a></li>
  </ul>
  <p>{t("rodape.atualizado", { data: buildDate })}</p>
</footer>
<style>
  .site-footer {
    max-width: var(--wide);
    margin-inline: auto;
    padding: var(--space-6) var(--space-4) var(--space-7);
    border-block-start: 1px solid var(--color-rule);
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }
  .site-footer > * + * {
    margin-block-start: var(--space-3);
  }
  .footer-links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    padding: 0;
  }
  .footer-links a {
    display: inline-flex;
    align-items: center;
  }
</style>

---
import { t } from "../i18n";

const buildDate = new Date().toISOString().slice(0, 10);
const links = [
  { href: "http://lattes.cnpq.br/5793944765294091", key: "perfil.lattes" },
  { href: "https://www.linkedin.com/in/jalinegm/", key: "perfil.linkedin" },
  { href: "https://github.com/jalinegm", key: "perfil.github" },
];
---
<footer class="site-footer">
  <p>{t("rodape.instituicao")}</p>
  <ul class="footer-links">
    {links.map((l) => (
      <li><a href={l.href}>{t(l.key)}</a></li>
    ))}
    <li><a href="/acessibilidade">{t("rodape.acessibilidade")}</a></li>
  </ul>
  <p>{t("rodape.atualizado", { data: buildDate })}</p>
</footer>
<style>
  .site-footer {
    padding: var(--space-5) var(--space-4);
    background: var(--color-surface);
    border-block-start: 1px solid var(--color-border);
    font-size: var(--font-size-sm);
  }
  .footer-links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    padding: 0;
  }
  .footer-links a {
    display: inline-flex;
    align-items: center;
  }
</style>

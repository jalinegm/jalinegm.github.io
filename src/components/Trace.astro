---
/**
 * Traço de pré-escrita desenhado como captura de toque: laçadas contínuas, cor por velocidade
 * (lento = âmbar, médio = rosa, rápido = azul) e espessura por pressão. Decorativo.
 * Além do traço fixo, o ponteiro deixa uma trilha que se apaga (ilha em TypeScript puro).
 */
const W = 1200;
const H = 260;
const LOOPS = 6;
const POINTS = 360;
const a = W / (2 * Math.PI * LOOPS);
const b = a * 2.1;

const pts = Array.from({ length: POINTS + 1 }, (_, i) => {
  const th = (i / POINTS) * 2 * Math.PI * LOOPS;
  return { x: a * th - b * Math.sin(th) + b * 0 , y: H / 2 - b * Math.cos(th) * 0.95, th };
});
const xs = pts.map((p) => p.x);
const minX = Math.min(...xs);
const scale = (W - 40) / (Math.max(...xs) - minX);
pts.forEach((p) => {
  p.x = 20 + (p.x - minX) * scale;
});

const speed = (i: number) => {
  const p = pts[Math.max(0, i - 1)];
  const q = pts[Math.min(POINTS, i + 1)];
  return Math.hypot(q.x - p.x, q.y - p.y);
};
const speeds = pts.map((_, i) => speed(i));
const lo = Math.min(...speeds);
const hi = Math.max(...speeds);

const STEP = 3;
const segments = [] as { d: string; color: string; width: number }[];
for (let i = 0; i < POINTS; i += STEP) {
  const seg = pts.slice(i, Math.min(POINTS, i + STEP) + 1);
  const v = (speeds[i] - lo) / (hi - lo || 1);
  const color =
    v < 0.5
      ? `color-mix(in srgb, var(--trace-slow) ${Math.round((1 - v * 2) * 100)}%, var(--trace-mid))`
      : `color-mix(in srgb, var(--trace-fast) ${Math.round((v * 2 - 1) * 100)}%, var(--trace-mid))`;
  const width = 5 + 7 * (1 - v);
  const d = seg.map((p, k) => `${k === 0 ? "M" : "L"}${p.x.toFixed(1)} ${p.y.toFixed(1)}`).join("");
  segments.push({ d, color, width });
}
---
<div class="trace" aria-hidden="true">
  <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid meet" focusable="false">
    {segments.map((s, i) => (
      <path d={s.d} style={`stroke:${s.color};stroke-width:${s.width.toFixed(1)};--i:${i}`} />
    ))}
  </svg>
  <canvas class="trace-live"></canvas>
</div>
<style>
  .trace {
    position: relative;
    overflow: hidden;
  }
  @media (max-width: 40rem) {
    svg {
      width: 190%;
      max-width: none;
      margin-inline-start: -20%;
    }
  }
  svg path {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    animation: trace-in 0.05s var(--ease-out) backwards;
    animation-delay: calc(var(--i) * 14ms + 150ms);
  }
  @keyframes trace-in {
    from {
      opacity: 0;
    }
  }
  .trace-live {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
</style>
<script>
  const root = document.querySelector<HTMLElement>(".trace");
  const canvas = root?.querySelector<HTMLCanvasElement>(".trace-live");
  const host = root?.closest<HTMLElement>(".hero") ?? root;
  const ctx = canvas?.getContext("2d");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (root && canvas && ctx && host && !reduce.matches) {
    let last: { x: number; y: number; t: number } | null = null;
    let raf = 0;
    let idleSince = 0;

    const size = () => {
      const r = host.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(r.width * dpr);
      canvas.height = Math.round(r.height * dpr);
      canvas.style.cssText = `position:absolute;left:0;top:${root.offsetTop * 0}px;width:${r.width}px;height:${r.height}px`;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    const ramp = (v: number) => {
      const cs = getComputedStyle(document.documentElement);
      const name = v < 0.33 ? "--trace-slow" : v < 0.66 ? "--trace-mid" : "--trace-fast";
      return cs.getPropertyValue(name).trim() || "#ffb703";
    };

    const frame = (now: number) => {
      ctx.globalCompositeOperation = "destination-out";
      ctx.fillStyle = "rgba(0,0,0,0.045)";
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.globalCompositeOperation = "source-over";
      if (now - idleSince < 2500) raf = requestAnimationFrame(frame);
      else {
        raf = 0;
        ctx.clearRect(0, 0, canvas.width, canvas.height);
      }
    };

    host.addEventListener("pointermove", (e) => {
      const r = host.getBoundingClientRect();
      const x = e.clientX - r.left;
      const y = e.clientY - r.top;
      const t = performance.now();
      if (last) {
        const v = Math.min(1, Math.hypot(x - last.x, y - last.y) / Math.max(1, t - last.t) / 2.2);
        ctx.strokeStyle = ramp(v);
        ctx.lineWidth = 3 + 10 * (1 - v);
        ctx.lineCap = "round";
        ctx.beginPath();
        ctx.moveTo(last.x, last.y);
        ctx.lineTo(x, y);
        ctx.stroke();
      }
      last = { x, y, t };
      idleSince = t;
      if (!raf) raf = requestAnimationFrame(frame);
    });
    host.addEventListener("pointerleave", () => {
      last = null;
    });

    size();
    window.addEventListener("resize", size);
  }
</script>

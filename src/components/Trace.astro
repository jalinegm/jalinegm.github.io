---
import { t } from "../i18n";
/**
 * Traço de pré-escrita desenhado como captura de toque: laçadas contínuas, cor por velocidade
 * (lento = âmbar, médio = rosa, rápido = azul) e espessura por pressão. Ilustrativo e sintético.
 * Além do traço fixo, o ponteiro deixa uma trilha que se apaga (ilha em TypeScript puro).
 */
const W = 1200;
const H = 260;
const LOOPS = 6;
const POINTS = 420;
const a = W / (2 * Math.PI * LOOPS);
// Autoria do gesto: tamanho e inclinação de cada laçada, uma hesitação e uma pausa da caneta.
const raio = [1.9, 1.5, 2.35, 1.7, 2.6, 1.55];
const tilt = [0.0, 0.18, -0.1, 0.22, -0.16, 0.1];
const at = (arr: number[], u: number) => {
  const k = Math.min(arr.length - 1, Math.floor(u));
  const f = u - k;
  const s = f * f * (3 - 2 * f);
  return arr[k] * (1 - s) + arr[Math.min(arr.length - 1, k + 1)] * s;
};
const GAP = [212, 219];
const HESITA = 128;

const pts = Array.from({ length: POINTS + 1 }, (_, i) => {
  const u = (i / POINTS) * LOOPS;
  const th = u * 2 * Math.PI;
  const b = a * at(raio, u);
  const x = a * th - b * Math.sin(th) + at(tilt, u) * b * Math.cos(th);
  const y = H / 2 - b * Math.cos(th) * 0.95 - Math.sin(th * 0.5) * 6;
  return { x, y };
});
const xs = pts.map((p) => p.x);
const minX = Math.min(...xs);
const scale = (W - 40) / (Math.max(...xs) - minX);
pts.forEach((p) => {
  p.x = 20 + (p.x - minX) * scale;
});

const speeds = pts.map((_, i) => {
  const p = pts[Math.max(0, i - 1)];
  const q = pts[Math.min(POINTS, i + 1)];
  const base = Math.hypot(q.x - p.x, q.y - p.y);
  return Math.abs(i - HESITA) < 6 ? base * 0.25 : base;
});
const lo = Math.min(...speeds);
const hi = Math.max(...speeds);

const STEP = 3;
const segments = [] as { d: string; color: string; width: number }[];
for (let i = 0; i < POINTS; i += STEP) {
  if (i >= GAP[0] && i < GAP[1]) continue;
  const seg = pts.slice(i, Math.min(POINTS, i + STEP) + 1);
  const v = (speeds[i] - lo) / (hi - lo || 1);
  const color =
    v < 0.5
      ? `color-mix(in srgb, var(--trace-slow) ${Math.round((1 - v * 2) * 100)}%, var(--trace-mid))`
      : `color-mix(in srgb, var(--trace-fast) ${Math.round((v * 2 - 1) * 100)}%, var(--trace-mid))`;
  const width = 2 + 13 * Math.pow(1 - v, 1.3);
  const d = seg.map((p, k) => `${k === 0 ? "M" : "L"}${p.x.toFixed(1)} ${p.y.toFixed(1)}`).join("");
  segments.push({ d, color, width });
}
// Pontos de amostragem nos instantes mais lentos.
const dots = speeds
  .map((v, i) => ({ v, i }))
  .filter(({ i }) => i % 14 === 0 && !(i >= GAP[0] && i < GAP[1]))
  .filter(({ v }) => v < lo + (hi - lo) * 0.18)
  .map(({ i }) => pts[i]);
---
<figure class="trace">
  <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid meet" focusable="false" aria-hidden="true">
    {segments.map((s, i) => (
      <path d={s.d} style={`stroke:${s.color};stroke-width:${s.width.toFixed(1)};--i:${i}`} />
    ))}
    {dots.map((p) => <circle cx={p.x.toFixed(1)} cy={p.y.toFixed(1)} r="3" class="dot" />)}
  </svg>
  <figcaption>{t("inicio.tracoLegenda")}</figcaption>
</figure>
<style>
  .trace {
    position: relative;
    overflow: hidden;
  }
  @media (max-width: 40rem) {
    svg {
      width: 190%;
      max-width: none;
      margin-inline-start: -20%;
    }
  }
  figcaption {
    max-width: 62ch;
    margin-block-start: var(--space-3);
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }
  .dot {
    fill: var(--color-text);
    opacity: 0.8;
  }
  svg path {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    animation: trace-in 0.05s var(--ease-out) backwards;
    animation-delay: calc(var(--i) * 12ms + 150ms);
  }
  @keyframes trace-in {
    from {
      opacity: 0;
    }
  }
</style>
<script>
  const root = document.querySelector<HTMLElement>(".trace");
  const host = root?.closest<HTMLElement>(".hero") ?? root;
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (root && host && !reduce.matches) {
    const canvas = document.createElement("canvas");
    canvas.className = "trace-live";
    canvas.setAttribute("aria-hidden", "true");
    host.appendChild(canvas);
    const ctx = canvas.getContext("2d");

    if (ctx) {
      let last: { x: number; y: number; t: number } | null = null;
      let raf = 0;
      let idleSince = 0;

      const size = () => {
        const r = host.getBoundingClientRect();
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        canvas.width = Math.round(r.width * dpr);
        canvas.height = Math.round(r.height * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      };

      const ramp = (v: number) => {
        const cs = getComputedStyle(document.documentElement);
        const name = v < 0.33 ? "--trace-slow" : v < 0.66 ? "--trace-mid" : "--trace-fast";
        return cs.getPropertyValue(name).trim() || "#ffb703";
      };

      const frame = (now: number) => {
        ctx.save();
        ctx.setTransform(1, 0, 0, 1, 0, 0);
        ctx.globalCompositeOperation = "destination-out";
        ctx.fillStyle = "rgba(0,0,0,0.045)";
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        ctx.restore();
        if (now - idleSince < 2500) raf = requestAnimationFrame(frame);
        else {
          raf = 0;
          ctx.save();
          ctx.setTransform(1, 0, 0, 1, 0, 0);
          ctx.clearRect(0, 0, canvas.width, canvas.height);
          ctx.restore();
        }
      };

      host.addEventListener("pointermove", (e) => {
        const r = host.getBoundingClientRect();
        const x = e.clientX - r.left;
        const y = e.clientY - r.top;
        const now = performance.now();
        if (last) {
          const v = Math.min(1, Math.hypot(x - last.x, y - last.y) / Math.max(1, now - last.t) / 2.2);
          ctx.strokeStyle = ramp(v);
          ctx.lineWidth = 3 + 10 * (1 - v);
          ctx.lineCap = "round";
          ctx.beginPath();
          ctx.moveTo(last.x, last.y);
          ctx.lineTo(x, y);
          ctx.stroke();
        }
        last = { x, y, t: now };
        idleSince = now;
        if (!raf) raf = requestAnimationFrame(frame);
      });
      host.addEventListener("pointerleave", () => {
        last = null;
      });

      size();
      new ResizeObserver(size).observe(host);
    }
  }
</script>

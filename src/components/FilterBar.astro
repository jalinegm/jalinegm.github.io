---
import { t } from "../i18n";

interface Opcao {
  valor: string;
  rotulo: string;
}

interface Props {
  listaId: string;
  tipos?: Opcao[];
  anos?: string[];
  temas?: Opcao[];
  linguagens?: Opcao[];
  visibilidades?: Opcao[];
  total: number;
  /** Rótulo do grupo de filtros (aria-label do formulário). */
  legenda?: string;
  /** Textos de contagem; `{n}` é substituído pelo número. */
  resultados?: { um: string; varios: string };
  /** Destino do link "Limpar filtros" sem JavaScript. */
  limparHref?: string;
}

const {
  listaId,
  tipos = [],
  anos = [],
  temas = [],
  linguagens = [],
  visibilidades = [],
  total,
  legenda = t("filtro.legenda"),
  resultados = { um: t("filtro.resultadoUm"), varios: t("filtro.resultados") },
  limparHref = "/pesquisa",
} = Astro.props;

const textoInicial = total === 1 ? resultados.um : resultados.varios.replace("{n}", String(total));
---
<form
  class="filtros"
  method="get"
  role="search"
  aria-label={legenda}
  data-filtro
  data-lista={listaId}
  data-res-um={resultados.um}
  data-res-varios={resultados.varios}
>
  <div class="filtros-campos">
    {visibilidades.length > 0 && (
      <div class="campo">
        <label for={`${listaId}-visibilidade`}>{t("filtro.visibilidade")}</label>
        <select id={`${listaId}-visibilidade`} name="visibilidade">
          <option value="">{t("filtro.todos")}</option>
          {visibilidades.map((o) => <option value={o.valor}>{o.rotulo}</option>)}
        </select>
      </div>
    )}
    {tipos.length > 0 && (
      <div class="campo">
        <label for={`${listaId}-tipo`}>{t("filtro.tipo")}</label>
        <select id={`${listaId}-tipo`} name="tipo">
          <option value="">{t("filtro.todos")}</option>
          {tipos.map((o) => <option value={o.valor}>{o.rotulo}</option>)}
        </select>
      </div>
    )}
    {linguagens.length > 0 && (
      <div class="campo">
        <label for={`${listaId}-linguagem`}>{t("filtro.linguagem")}</label>
        <select id={`${listaId}-linguagem`} name="linguagem">
          <option value="">{t("filtro.todos")}</option>
          {linguagens.map((o) => <option value={o.valor}>{o.rotulo}</option>)}
        </select>
      </div>
    )}
    {anos.length > 0 && (
      <div class="campo">
        <label for={`${listaId}-ano`}>{t("filtro.ano")}</label>
        <select id={`${listaId}-ano`} name="ano">
          <option value="">{t("filtro.todos")}</option>
          {anos.map((a) => <option value={a}>{a}</option>)}
        </select>
      </div>
    )}
    {temas.length > 0 && (
      <div class="campo">
        <label for={`${listaId}-tema`}>{t("filtro.tema")}</label>
        <select id={`${listaId}-tema`} name="tema">
          <option value="">{t("filtro.todos")}</option>
          {temas.map((o) => <option value={o.valor}>{o.rotulo}</option>)}
        </select>
      </div>
    )}
    <div class="campo campo-busca">
      <label for={`${listaId}-q`}>{t("filtro.busca")}</label>
      <input id={`${listaId}-q`} name="q" type="search" autocomplete="off" aria-describedby={`${listaId}-q-ajuda`} />
      <p id={`${listaId}-q-ajuda`} class="ajuda">{t("filtro.buscaAjuda")}</p>
    </div>
  </div>
  <div class="filtros-acoes">
    <button type="submit">{t("filtro.aplicar")}</button>
    <a class="button-link" href={limparHref} data-limpar>{t("filtro.limpar")}</a>
  </div>
</form>
<p class="resultados" aria-live="polite" data-contagem>{textoInicial}</p>
<div class="vazio" data-vazio hidden>
  <p>{t("filtro.vazio")}</p>
  <a class="button-link" href={limparHref} data-limpar>{t("filtro.limpar")}</a>
</div>
<noscript><p class="ajuda">{t("filtro.semJs")}</p></noscript>

<script>
  import { matchesFiltro, parseQuery, serializeQuery, type FiltroQuery } from "../lib/filters";

  // Aprimoramento progressivo: sem JS, a lista completa já está no HTML.
  const form = document.querySelector<HTMLFormElement>("form[data-filtro]");
  const lista = form ? document.getElementById(form.dataset.lista ?? "") : null;

  if (form && lista) {
    const contagem = document.querySelector<HTMLElement>("[data-contagem]");
    const vazio = document.querySelector<HTMLElement>("[data-vazio]");
    const itens = Array.from(lista.querySelectorAll<HTMLElement>("[data-filtro-item]"));
    const textoResultados = (n: number) =>
      n === 1 ? (form.dataset.resUm ?? "") : (form.dataset.resVarios ?? "").replace("{n}", String(n));

    const campo = (nome: string) =>
      form.elements.namedItem(nome) as HTMLInputElement | HTMLSelectElement | null;

    // Só lê os campos que existem neste formulário; chaves ausentes ficam vazias.
    const ler = (): FiltroQuery => ({
      tipo: campo("tipo")?.value ?? "",
      ano: campo("ano")?.value ?? "",
      tema: campo("tema")?.value ?? "",
      q: campo("q")?.value ?? "",
      linguagem: campo("linguagem")?.value ?? "",
      visibilidade: campo("visibilidade")?.value ?? "",
    });

    const preencher = (q: FiltroQuery) => {
      for (const nome of ["tipo", "ano", "tema", "q", "linguagem", "visibilidade"] as const) {
        const el = campo(nome);
        if (el) el.value = q[nome] ?? "";
      }
    };

    const aplicar = (q: FiltroQuery, atualizarUrl: boolean) => {
      let visiveis = 0;
      for (const li of itens) {
        const ok = matchesFiltro(
          {
            tipo: li.dataset.tipo ?? "",
            ano: li.dataset.ano ?? "",
            tema: li.dataset.tema ?? "",
            texto: li.dataset.texto ?? "",
            linguagem: li.dataset.linguagem ?? "",
            visibilidade: li.dataset.visibilidade ?? "",
          },
          q,
        );
        li.hidden = !ok;
        if (ok) visiveis++;
      }
      if (contagem) contagem.textContent = textoResultados(visiveis);
      if (vazio) vazio.hidden = visiveis > 0;
      if (atualizarUrl) {
        try {
          history.replaceState(null, "", `${location.pathname}${serializeQuery(q)}${location.hash}`);
        } catch {
          /* history indisponível: os filtros continuam funcionando na página */
        }
      }
    };

    const inicial = parseQuery(location.search);
    preencher(inicial);
    aplicar(ler(), false);

    // Digitação no campo de busca é adiada (400 ms) para não anunciar a cada tecla
    // no aria-live; seleções aplicam na hora.
    let pendente: number | undefined;
    const cancelarPendente = () => {
      if (pendente !== undefined) window.clearTimeout(pendente);
      pendente = undefined;
    };

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      cancelarPendente();
      aplicar(ler(), true);
    });
    form.addEventListener("input", (event) => {
      if ((event.target as HTMLElement | null)?.getAttribute("name") === "q") {
        cancelarPendente();
        pendente = window.setTimeout(() => {
          pendente = undefined;
          aplicar(ler(), true);
        }, 400);
        return;
      }
      cancelarPendente();
      aplicar(ler(), true);
    });
    form.addEventListener("change", () => {
      cancelarPendente();
      aplicar(ler(), true);
    });

    document.querySelectorAll<HTMLAnchorElement>("a[data-limpar]").forEach((link) => {
      link.addEventListener("click", (event) => {
        event.preventDefault();
        cancelarPendente();
        const vazioQ: FiltroQuery = { tipo: "", ano: "", tema: "", q: "", linguagem: "", visibilidade: "" };
        preencher(vazioQ);
        aplicar(vazioQ, true);
        campo("q")?.focus();
      });
    });

    window.addEventListener("popstate", () => {
      preencher(parseQuery(location.search));
      aplicar(ler(), false);
    });
  }
</script>

<style>
  .filtros {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-4);
    margin-block: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
  }
  .filtros-campos {
    display: grid;
    gap: var(--space-3);
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
  }
  .campo {
    display: grid;
    gap: var(--space-1);
  }
  .campo-busca {
    grid-column: 1 / -1;
  }
  .campo select,
  .campo input {
    font: inherit;
    color: inherit;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-2);
    max-inline-size: 100%;
  }
  .ajuda {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
  }
  .filtros-acoes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .resultados {
    font-weight: 600;
  }
  .vazio {
    padding: var(--space-4);
    border: 1px dashed var(--color-border);
    border-radius: var(--radius);
  }
  .vazio[hidden] {
    display: none;
  }
</style>

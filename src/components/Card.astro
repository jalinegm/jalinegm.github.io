---
import Badge from "./Badge.astro";
import { t } from "../i18n";

interface BadgeItem {
  variante: "neutro" | "info" | "alerta";
  texto: string;
}

interface Props {
  titulo: string;
  /** Sem href (ex.: repositório privado), o título é texto simples, sem link. */
  href?: string;
  /** Marca o link como externo para leitores de tela. */
  externo?: boolean;
  descricao: string;
  /** Idioma do texto da descrição, quando diferente do português. */
  descricaoLang?: string;
  badges?: BadgeItem[];
  imagem?: string;
  alt?: string;
}

const { titulo, href, externo = false, descricao, descricaoLang, badges = [], imagem, alt } = Astro.props;
if (imagem && alt === undefined) throw new Error(`Card "${titulo}": imagem exige alt (use "" apenas se decorativa)`);
---
<article class="card">
  {imagem && <img src={imagem} alt={alt} loading="lazy" />}
  <h3>
    {href ? (
      <a href={href}>
        {titulo}
        {externo && <span class="visually-hidden"> {t("link.externo")}</span>}
      </a>
    ) : (
      titulo
    )}
  </h3>
  <p lang={descricaoLang}>{descricao}</p>
  {badges.length > 0 && (
    <ul class="card-badges">
      {badges.map((b) => (
        <li><Badge variante={b.variante} texto={b.texto} /></li>
      ))}
    </ul>
  )}
</article>
<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-block-start: var(--space-4);
    border-block-start: 2px solid var(--color-border);
  }
  .card::before {
    content: "";
    position: absolute;
    inset-block-start: -4px;
    inset-inline-start: 0;
    inset-inline-end: 0;
    height: 6px;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--trace-slow), var(--trace-mid));
    transform: scaleX(0.14);
    transform-origin: left;
    transition: transform 0.45s var(--ease-out);
  }
  .card:hover::before,
  .card:focus-within::before {
    transform: scaleX(1);
  }
  .card img {
    border-radius: var(--radius);
  }
  .card h3 a {
    color: var(--color-text);
    text-decoration-color: transparent;
  }
  .card h3 a:hover,
  .card h3 a:focus-visible {
    text-decoration-color: currentColor;
  }
  .card-badges {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
  }
</style>
